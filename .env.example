# Defina valores apenas em ambientes privados (Vercel → Settings → Environment Variables).
# Nunca commitar chaves reais. Variáveis ausentes desativam a integração correspondente
# e a interface informa isso explicitamente; nada é simulado como se fosse real.

# --- Projeto -------------------------------------------------------------------
# Nome exibido na capa do relatório e do PDF.
NEXT_PUBLIC_PROJECT_NAME="Mapa de Talentos"
# Nome do cliente/organização. Deixe vazio quando não houver: a capa omite o campo.
REPORT_CLIENT_NAME=
# URL pública da aplicação, usada nos links do e-mail (ex.: https://mapa.exemplo.com).
APP_BASE_URL=

# --- Voz: Agora (Lia) ----------------------------------------------------------
# A camada lib/voice tem o contrato pronto; o adaptador Agora ainda não foi ligado.
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
AGORA_CUSTOMER_ID=
AGORA_CUSTOMER_SECRET=

# --- Analista LLM (Prompt B) ---------------------------------------------------
# Qualquer endpoint compatível com /chat/completions.
ANALYST_LLM_API_KEY=
ANALYST_LLM_BASE_URL=https://api.openai.com/v1
ANALYST_LLM_MODEL=gpt-4o-mini

# --- Armazenamento persistente (Upstash Redis / Vercel KV via REST) ------------
# Necessário em produção para relatórios reais, códigos de verificação e limites.
# Sem ele, apenas o armazenamento em memória do ambiente local é usado.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Dias até um relatório real expirar.
REPORT_TTL_DAYS=30

# --- E-mail transacional (Resend) ----------------------------------------------
RESEND_API_KEY=
# Remetente em domínio verificado no Resend, ex.: "Mapa de Talentos <mapa@seudominio.com>"
EMAIL_FROM=
# Segredo para derivar hashes de e-mail e códigos (32+ caracteres aleatórios).
EMAIL_HASH_SECRET=
