# /etc/pontos-fortes/runtime.env  (root:pf-api, 640). Gerado por allowlist; nunca copiar o .env inteiro.
PF_ENV=prod
PF_PUBLIC_URL=https://pontosfortes.<ip>.sslip.io
PF_TOOLS_URL=https://pontosfortes.<ip>.sslip.io
# Opcional: ID interno de uma conta existente autorizada a repetir as próprias entrevistas de teste.
PF_INTERVIEW_MASTER_USER_ID=
PF_DB_PASSWORD=<aleatória>
PF_DATABASE_URL=postgresql+psycopg://pontos:<mesma senha>@127.0.0.1:5432/pontos
PF_JWT_SECRET=<64 caracteres aleatórios>
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
OPENAI_MODEL=gpt-4o-mini
TTS_MODEL=speech_2_6_turbo
TTS_VOICE_ID=Portuguese_SentimentalLady
# minimax (padrão, com language_boost) ou openai (tts-1 gerenciado pela Agora; voz nova/shimmer/alloy...)
TTS_VENDOR=minimax
TTS_LANGUAGE_BOOST=Portuguese
TTS_SPEED=1.0
# Para pt-BR nativo: TTS_VENDOR=microsoft, TTS_VOICE_ID=pt-BR-FranciscaNeural (ou pt-BR-AntonioNeural, pt-BR-ThalitaMultilingualNeural)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=brazilsouth
# E-mail dos convites (SMTP). Vazio: a empresa copia o link na tela.
PF_SMTP_HOST=
PF_SMTP_PORT=587
PF_SMTP_USER=
PF_SMTP_PASSWORD=
PF_SMTP_FROM=
# Analista de texto (prompt B do Mapa de Talentos). Vazio: relatório pelas evidências da Lia.
ANALYST_LLM_API_KEY=
ANALYST_LLM_MODEL=gpt-4o-mini
# false pausa compras individuais e abre os testes gratuitos para contas Individuais e a conta mestre.
PF_INTERVIEW_PAYMENTS_ENABLED=false
# Stripe: somente chaves de teste (sk_test_). Vazio em prod desliga compra e assinatura.
# Local: ficam fora do repositório, em ~/.config/pontos-fortes/stripe.env (ou PF_STRIPE_ENV_FILE).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# true só depois de ativar a Stripe Tax com registro fiscal; NFS-e brasileira continua fora da Stripe.
STRIPE_AUTOMATIC_TAX=false
PF_SALES_EMAIL=
